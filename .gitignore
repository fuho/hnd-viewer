# Vendored Flutter SDK (toolchain only — not part of the app source)
.flutter/

# Flutter's per-user state (config + pub cache) redirected here to stay inside
# the workspace sandbox.
.flutter-user/

# Gradle cache redirected here to stay inside the workspace sandbox.
.gradle/

# Workspace-local Android SDK overlay (symlinks to the real SDK + android-36).
.android-sdk/
.sdk-dl/

# Packaging output (flutter_distributor) and CI release staging.
/dist/
/release-files/

# Large original screen recordings (a compressed .mp4 copy is committed instead).
media/screenshots/*.mov
